; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Underworlds: Descent into Darkness"
config/description="A first-person, turn-based dungeon crawler."
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/data/data.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1422
window/size/viewport_height=800
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Underworlds Descent into Darkness"

[editor_plugins]

enabled=PackedStringArray("res://addons/dice_3d/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.0588, 0.0667, 0.098, 1)
